# Groq AI
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Live AI mentor sessions (Groq transcribes microphone chunks)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Use a long random value in production to keep account session tokens valid after restart.
AUTH_SECRET=replace-with-a-long-random-secret

# Required for reliable WebRTC calls across different networks (Twilio, Metered, or coturn)
TURN_URL=turn:your-turn-server:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password

# Resend Email
RESEND_API_KEY=re_your-resend-api-key-here
RESEND_FROM_EMAIL=mentor@mentormatcher.app

# Sentry
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
